<configs>
	<!-- Visible Clothing: give the 3.2 clothing items a model. The DLL hides each one while the
	     matching armor piece is drawn (equipped and not set to Hidden in the cosmetic menu). -->
	<append xpath="/items/item[@name='clothingHeadT1']">
		<property class="SDCS">
			<property name="Prefab" value="#@modfolder:Resources/VisibleClothing.unity3d?gear{sex}ClothingHeadT1"/>
			<property name="TransformName" value="head"/>
			<property name="Excludes" value=""/>
			<property name="HairMaskType" value="Hat"/>
			<property name="FacialHairMaskType" value="Full"/>
		</property>
	</append>
